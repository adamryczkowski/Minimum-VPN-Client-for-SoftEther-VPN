// Markdownlint configuration for SoftEther Connect
// See: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
{
  // Default state for all rules
  "default": true,

  // Line length - disable (too strict for documentation)
  "MD013": false,

  // Allow inline HTML (needed for some documentation)
  "MD033": false,

  // Allow duplicate headings in different sections
  "MD024": {
    "siblings_only": true
  },

  // Allow trailing punctuation in headings (for questions)
  "MD026": {
    "punctuation": ".,;:!"
  },

  // Allow multiple top-level headings (for changelogs, etc.)
  "MD025": false,

  // Disable first line must be heading (for some docs)
  "MD041": false,

  // Allow bare URLs (common in technical docs)
  "MD034": false,

  // Fenced code blocks don't require language (allow empty)
  "MD040": false,

  // Table column style - disable (too strict for generated tables)
  "MD060": false,

  // Emphasis used instead of heading - disable (common in docs)
  "MD036": false,

  // Link text should be descriptive - disable (too strict)
  "MD059": false,

  // Images should have alt text - disable (too strict for screenshots)
  "MD045": false
}
