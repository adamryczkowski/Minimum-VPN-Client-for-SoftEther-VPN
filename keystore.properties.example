# Release Keystore Configuration
# Copy this file to keystore.properties and fill in your values.
# DO NOT commit keystore.properties to version control!
#
# To generate a new keystore:
#   keytool -genkey -v -keystore release.keystore -alias softether-connect \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Store the keystore file securely and back it up!
# If you lose it, you cannot update your app on Google Play.

# Path to your keystore file (relative to project root or absolute)
storeFile=release.keystore

# Keystore password
storePassword=your_keystore_password

# Key alias
keyAlias=softether-connect

# Key password
keyPassword=your_key_password
